# =============================================================================
# PredictFlow — environment variables
# =============================================================================
# Copy this file to `.env.local` and adjust as needed.
#
#   cp .env.example .env.local
#
# All variables here are PUBLIC (NEXT_PUBLIC_*) — they are inlined into the
# client bundle by Next.js. NEVER put secrets, private keys, or seed phrases
# in this file or in `.env.local`.
#
# The testnet object/package IDs below are the demo values used at the time of
# the Sui Overflow 2026 / ON THE MOVE presentation. They may rotate at any time
# — verify against the latest Sui / DeepBook Predict documentation before use.
# =============================================================================


# ----- Data mode -------------------------------------------------------------
# `simulated`  — use mock markets and a simplified pricing formula. Works
#                offline. Safest default if you just want to explore the UI.
# `testnet`    — read live markets from the Predict server and price using the
#                real on-chain `get_trade_amounts` / `get_range_trade_amounts`.
#                Requires a funded Sui Testnet wallet to actually place a
#                prediction.
NEXT_PUBLIC_DATA_MODE=simulated


# ----- DeepBook Predict (Sui Testnet) ----------------------------------------
# Predict server URL — provides live markets, vaults, positions, PnL.
NEXT_PUBLIC_PREDICT_SERVER=https://predict-server.testnet.mystenlabs.com

# DeepBook Predict on-chain IDs (Sui Testnet at time of demo).
NEXT_PUBLIC_PREDICT_PACKAGE=0xf5ea2b3749c65d6e56507cc35388719aadb28f9cab873696a2f8687f5c785138
NEXT_PUBLIC_PREDICT_REGISTRY=0x43af14fed5480c20ff77e2263d5f794c35b9fab7e2212903127062f4fe2a6e64
NEXT_PUBLIC_PREDICT_OBJECT=0xc8736204d12f0a7277c86388a68bf8a194b0a14c5538ad13f22cbd8e2a38028a

# Optional: pin a specific predict manager (BTC/USD market) by object ID.
# Leave empty to let the app auto-select the first live BTC/USD manager.
NEXT_PUBLIC_PREDICT_MANAGER=


# ----- Asset types -----------------------------------------------------------
# Quote asset for predictions on testnet — DUSDC (DeepBook testnet stablecoin).
NEXT_PUBLIC_DUSDC_TYPE=0xe95040085976bfd54a1a07225cd46c8a2b4e8e2b6732f140a0fc49850ba73e1a::dusdc::DUSDC

# Predict LP token type.
NEXT_PUBLIC_PLP_TYPE=0xf5ea2b3749c65d6e56507cc35388719aadb28f9cab873696a2f8687f5c785138::plp::PLP


# ----- Sui Payment Kit -------------------------------------------------------
# `simulated`  — no real payment, just a mock receipt.
# `testnet`    — emit a real Payment Kit intent + receipt on Sui Testnet,
#                bundled into the same PTB as the predict mint.
NEXT_PUBLIC_PAYMENT_MODE=simulated

# Payment Kit on-chain IDs (Sui Testnet at time of demo).
NEXT_PUBLIC_PAYKIT_NAMESPACE=0xa5016862fdccba7cc576b56cc5a391eda6775200aaa03a6b3c97d512312878db
NEXT_PUBLIC_PAYKIT_REGISTRY=0x9e2410eead3d1b648acabc73d651bc8acb4fff55c31da6f70c4719316cc18412

# Demo merchant address that receives the research fee. Replace with your own
# Sui Testnet address if you want to receive the test payments yourself.
NEXT_PUBLIC_MERCHANT_ADDRESS=0x59ca41790769d94e99550a02ddadfc9c36b6d2cee50e21a63192008dabed4cac
